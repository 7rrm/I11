<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- Google 3-Color Glass K: clean flat letter K with Google colors -->
    
    <group android:scaleX="0.66" android:scaleY="0.66" 
           android:translateX="87.04" android:translateY="88.60445">
        <group>
            <clip-path android:pathData="M0 0H512V512H0V0Z"/>
            
            <!-- المائل العلوي (أحمر Google - زجاجي) -->
            <path android:pathData="M150 256L360 150L420 150L210 256Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="150" android:startY="150"
                        android:endX="420" android:endY="256"
                        android:type="linear">
                        <item android:offset="0" android:color="#CCEA4335"/>
                        <item android:offset="0.5" android:color="#99EA4335"/>
                        <item android:offset="1" android:color="#66EA4335"/>
                    </gradient>
                </aapt:attr>
            </path>
            
            <!-- المائل السفلي (أحمر Google - زجاجي) -->
            <path android:pathData="M150 256L420 362L360 362L150 280Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="150" android:startY="256"
                        android:endX="420" android:endY="362"
                        android:type="linear">
                        <item android:offset="0" android:color="#CCEA4335"/>
                        <item android:offset="0.5" android:color="#99EA4335"/>
                        <item android:offset="1" android:color="#66EA4335"/>
                    </gradient>
                </aapt:attr>
            </path>
            
            <!-- الخط العمودي (أخضر Google - زجاجي) -->
            <path android:pathData="M86 150H150V362H86Z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="86" android:startY="150"
                        android:endX="150" android:endY="362"
                        android:type="linear">
                        <item android:offset="0" android:color="#CC34A853"/>
                        <item android:offset="0.5" android:color="#9934A853"/>
                        <item android:offset="1" android:color="#6634A853"/>
                    </gradient>
                </aapt:attr>
            </path>
            
            <!-- تأثير زجاجي (انعكاس الضوء) -->
            <path android:fillColor="#FFFFFF" 
                  android:alpha="0.08"
                  android:pathData="
                      M86 150H150V362H86Z
                      M150 256L360 150L420 150L210 256Z
                  "/>
            
            <!-- نقطة بريق -->
            <path android:fillColor="#FFFFFF" 
                  android:alpha="0.3"
                  android:pathData="
                      M100 160 L110 155 L115 160 L110 165 Z"/>
        </group>
    </group>
</vector>
